# Pinned third-party sources for the native decoders. Every entry is a full commit SHA that the build
# scripts verify after checkout, so a moved tag cannot silently change what ships.

# FFmpeg: LGPL-2.1+ build, audio decoders only, dynamically linked (separate .so files).
# Upstream Media3 documents FFmpeg release/6.0; n6.0.1 is the last tag on that branch.
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_TAG=n6.0.1
FFMPEG_COMMIT=c41ff724ede7da657762d61097e26fac296c53bf

# dav1d: BSD-2-Clause AV1 decoder, version pinned by androidx/media 1.11.0, linked statically into libdav1dJNI.so.
DAV1D_REPO=https://code.videolan.org/videolan/dav1d.git
DAV1D_REPO_MIRROR=https://github.com/videolan/dav1d.git
DAV1D_TAG=1.5.4
DAV1D_COMMIT=54706fc6bc0cdecab7e9593974a4039cc038fca7

# cpu_features: Apache-2.0, used by the dav1d JNI wrapper to pick a thread count.
CPU_FEATURES_REPO=https://github.com/google/cpu_features.git
CPU_FEATURES_TAG=v0.9.0
CPU_FEATURES_COMMIT=ba4bffa86cbb5456bdb34426ad22b9551278e2c0

# Toolchain. r26b is what the FFmpeg extension README documents as tested.
NDK_VERSION=26.1.10909125
CMAKE_VERSION=3.22.1

# Android API level used for the compiler triple (must not exceed minSdk 23).
ANDROID_API=23

# Audio decoders enabled in FFmpeg. These are exactly the codecs that FfmpegLibrary.getCodecName()
# (Media3 1.11.0) can map a MIME type to, minus the video ones (video stays on MediaCodec):
#   aac mp3 ac3 eac3 truehd dca(DTS, DTS-HD) vorbis opus amrnb amrwb flac alac pcm_mulaw pcm_alaw
FFMPEG_DECODERS="aac mp3 ac3 eac3 truehd dca vorbis opus amrnb amrwb flac alac pcm_mulaw pcm_alaw"
